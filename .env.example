# 为下列五个空值分别生成独立随机值（openssl rand -hex 32）。
# 数据库口令采用十六进制，Langflow DSN 可直接使用。
POSTGRES_PASSWORD=
PLATFORM_DB_PASSWORD=
LANGFLOW_DB_PASSWORD=
LANGFLOW_SUPERUSER=platform_admin
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=
LANGFLOW_PORT=7860

# 门户独立凭据。分别使用 openssl rand -hex 32 生成。
PLATFORM_ADMIN_USERNAME=portal_admin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_JWT_SECRET=
PLATFORM_COOKIE_SECURE=false
PORTAL_PORT=8080

# 运行 scripts/provision_langflow.py 生成模型加密密钥和 Langflow 服务凭据。
PLATFORM_MODEL_KEY=
PLATFORM_LANGFLOW_SERVICE_PASSWORD=

# 使用 openssl rand -hex 32 分别生成内部服务凭据。
PLATFORM_QDRANT_KEY=
PLATFORM_MCP_KEY=
# 可选 OpenAI-compatible Embedding 配置。首次启用时固定 HTTPS 地址和维度。
EMBEDDING_CLOUD_URL=
EMBEDDING_CLOUD_MODEL=
EMBEDDING_CLOUD_DIMENSION=
EMBEDDING_CLOUD_KEY=
